# Server Configuration
PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/thinkmate
JWT_SECRET=your_jwt_secret_key_here

# AI Model Provider (Groq / OpenAI compatible)
GROQ_API_KEY=your_groq_api_key_here

# Real-Time Web Search & Grounding
# Note: DuckDuckGo Lite & Wikipedia work automatically out of the box with zero configuration!
# You can optionally provide a Tavily API key for enhanced AI search results:
# TAVILY_API_KEY=tvly-your_tavily_key

# ImageKit Configuration (for AI-generated image hosting)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# Stripe Payments & Webhooks
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
